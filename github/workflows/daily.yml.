name: Daily Open Call Scan

on:
  schedule:
    - cron: "0 4 * * *"   # 04:00 UTC = 07:00 שעון ישראל (קיץ) — מייל מחכה לך בבוקר
  workflow_dispatch:

permissions:
  contents: write

jobs:
  scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run scanner
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          EMAIL_USER: ${{ secrets.EMAIL_USER }}
          EMAIL_APP_PASSWORD: ${{ secrets.EMAIL_APP_PASSWORD }}
          EMAIL_TO: ${{ secrets.EMAIL_TO }}
          DASHBOARD_URL: ${{ secrets.DASHBOARD_URL }}
        run: python scanner.py

      - name: Commit state and dashboard
        run: |
          git config user.name "opencall-bot"
          git config user.email "bot@users.noreply.github.com"
          git add seen.json opencalls.json docs/index.html || true
          git diff --cached --quiet || git commit -m "daily scan $(date -u +%F)"
          git push
